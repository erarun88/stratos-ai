# Base URL the frontend uses for API calls.
#
# Leave this UNSET for local dev and Codespaces: the app defaults to "/api",
# which the Vite dev server proxies to the FastAPI backend (see vite.config.ts).
#
# Only set this if you are NOT using the dev proxy (e.g. a deployed frontend
# pointing at a real backend URL):
# VITE_API_BASE_URL=https://api.your-backend.example.com
