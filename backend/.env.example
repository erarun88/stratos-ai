# PostgreSQL connection string used by SQLAlchemy (see backend/app/database.py)
DATABASE_URL=postgresql://user:password@host:5432/dbname

# --- Document Management ---------------------------------------------------
# Storage backend for document binaries. Only "local" is implemented today.
DOCUMENT_STORAGE_BACKEND=local
# Filesystem root for the local backend (default: backend/storage/documents)
# DOCUMENT_STORAGE_ROOT=/var/lib/stratos/documents
# Maximum accepted upload size, in megabytes (default: 25)
MAX_DOCUMENT_SIZE_MB=25

# Application log level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# --- AI & Embedding Configuration -------------------------------------------
# OpenAI API key for document embeddings
OPENAI_API_KEY=sk-...
# Embedding model (text-embedding-3-small or text-embedding-3-large)
EMBEDDING_MODEL=text-embedding-3-small
# Number of chunks to batch in a single OpenAI API request
EMBEDDING_BATCH_SIZE=20
# Enable/disable the async embedding worker
EMBEDDING_WORKER_ENABLED=true
# Maximum retry attempts for failed embedding requests
EMBEDDING_MAX_RETRIES=3
# Initial retry delay in seconds (exponential backoff: 1s, 5s, 30s, ...)
EMBEDDING_RETRY_DELAY=1
# Maximum chunk size in tokens (OpenAI embedding-3-small can handle up to 8191)
EMBEDDING_MAX_CHUNK_TOKENS=800
# Minimum chunk size in tokens (to avoid very small chunks)
EMBEDDING_MIN_CHUNK_TOKENS=100

# --- LLM Configuration (Phase 2: AI Project Assistant) --------------------
# LLM provider: "anthropic" (Claude) or "openai" (GPT-4)
LLM_PROVIDER=anthropic
# Model name for Claude 3.5 Sonnet or GPT-4
LLM_MODEL=claude-3-5-sonnet-20241022
# API key for Claude (Anthropic)
ANTHROPIC_API_KEY=sk-ant-...
# API key for OpenAI (if using GPT-4)
# OPENAI_API_KEY=sk-...
# Maximum tokens in LLM response
LLM_MAX_TOKENS=2000
# Sampling temperature (0.0-1.0, lower = more deterministic)
LLM_TEMPERATURE=0.7
# LLM API timeout in seconds
LLM_TIMEOUT_SECONDS=30
